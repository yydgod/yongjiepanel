# ---------- 基础 ----------
APP_NAME=永杰面板
ENV=dev

# ---------- 存储 ----------
# 默认落在 backend/data/board.db；容器内建议 sqlite:////data/board.db
DATABASE_URL=sqlite:///./data/board.db
SQLITE_WAL=true
# 首次启动是否写入演示卡片（从本机 Docker / systemd 自动发现）
SEED_DEMO=true

# ---------- 安全 ----------
# 留空表示不启用 Bearer 鉴权；设置后所有非 GET 请求需携带 Authorization: Bearer <token>
ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 采集 ----------
COLLECT_INTERVAL=5
COLLECT_TIMEOUT=8
DOCKER_ENABLED=true
SYSTEMD_ENABLED=true
PORT_ENABLED=true
METRIC_HISTORY_POINTS=180
# 主页看板：主机指标采样间隔（秒）与历史点数
HOST_INTERVAL=3
HOST_HISTORY_POINTS=120

# ---------- 文件管理 ----------
# 「文件管理」页签可浏览/修改的根目录；默认 /（容器内即容器根）
# 宿主机部署时 ProtectSystem=full 会让 / 只读，如需写入请同时调整 systemd 的 ReadWritePaths
FILE_ROOT=/
FILE_MAX_BYTES=2000000
FILE_PREVIEW_BYTES=1000000
# 文件树搜索：单次搜索耗时上限（秒）与最多扫描条目数
FILE_SEARCH_TIMEOUT=4
FILE_SEARCH_MAX_SCAN=200000

# ---------- dsh 原生工作区 ----------
DSH_BASE_URL=http://127.0.0.1:3082
DSH_TOKEN=
DSH_TOKEN_FILE=/data/yongjie/dsh-token
DSH_PUBLIC_URL=
DSH_CARDS_STORE=~/.dsh/storages/yongjie-cards.json
# 通过运行中 dsh 的 API 注册工作区（避免直接改注册表后被 dsh 内存状态覆盖）
DSH_REMOTE_WRITE=true
# 「AI 创建卡片」弹窗在该目录下创建 <目录名> 工作区，然后进入 dsh
WORKSPACE_ROOT=/data/workspaces

# ---------- 终端 ----------
# 终端可执行任意 shell 命令，暴露到公网前务必设置 ADMIN_TOKEN
TERMINAL_ENABLED=true
TERMINAL_TIMEOUT=30
TERMINAL_MAX_SESSIONS=8
TERMINAL_HISTORY_LIMIT=500
TERMINAL_HISTORY_FILE=./data/terminal_history.json
