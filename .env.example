# ---------- 基础 ----------
APP_NAME=永杰面板
ENV=dev

# ---------- 存储 ----------
# 默认落在 backend/data/board.db；容器内建议 sqlite:////data/board.db
DATABASE_URL=sqlite:///./data/board.db
SQLITE_WAL=true
# 首次启动是否写入演示卡片（从本机 Docker / systemd 自动发现）
SEED_DEMO=true

# ---------- 安全 ----------
# 用于加密 API Key 的 Fernet 派生密钥，生产环境务必替换为随机长字符串
SECRET_KEY=change-me-to-a-random-32byte-secret
# 留空表示不启用 Bearer 鉴权；设置后所有非 GET 请求需携带 Authorization: Bearer <token>
ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 采集 ----------
COLLECT_INTERVAL=5
COLLECT_TIMEOUT=8
DOCKER_ENABLED=true
SYSTEMD_ENABLED=true
PORT_ENABLED=true
METRIC_HISTORY_POINTS=180
# 主页看板：主机指标采样间隔（秒）与历史点数
HOST_INTERVAL=3
HOST_HISTORY_POINTS=120

# ---------- OpenClaw 网关 ----------
# 例如 http://127.0.0.1:18789；留空则直连供应商
OPENCLAW_BASE_URL=
OPENCLAW_TOKEN=
# openai = 网关暴露 OpenAI 兼容端点；channel = 网关暴露 /channel/message 会话端点
OPENCLAW_MODE=openai
OPENCLAW_HEALTH_TTL=30

# ---------- 大模型 ----------
LLM_TIMEOUT=60
# 无 Key 时允许使用离线演示通道（便于先体验交互，生产可关闭）
ALLOW_MOCK_AI=true
CHAT_MAX_TOOL_ROUNDS=4
CONFIRM_TOKEN_TTL=300

# 也可用环境变量预置 Key（与界面配置等价，界面写入后优先）
DEEPSEEK_API_KEY=
HUNYUAN_API_KEY=
QWEN_API_KEY=
