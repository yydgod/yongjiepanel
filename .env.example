# ---------- 基础 ----------
APP_NAME=永杰面板
ENV=dev

# ---------- 存储 ----------
# 默认落在 backend/data/board.db；容器内建议 sqlite:////data/board.db
DATABASE_URL=sqlite:///./data/board.db
SQLITE_WAL=true
# 首次启动是否写入演示卡片（从本机 Docker / systemd 自动发现）
SEED_DEMO=true

# ---------- 安全 ----------
# 留空表示不启用 Bearer 鉴权；设置后所有非 GET 请求需携带 Authorization: Bearer <token>
ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 采集 ----------
COLLECT_INTERVAL=5
COLLECT_TIMEOUT=8
DOCKER_ENABLED=true
SYSTEMD_ENABLED=true
PORT_ENABLED=true
METRIC_HISTORY_POINTS=180
# 主页看板：主机指标采样间隔（秒）与历史点数
HOST_INTERVAL=3
HOST_HISTORY_POINTS=120

# ---------- dsh 原生工作区 ----------
DSH_BASE_URL=http://127.0.0.1:3082
DSH_TOKEN=
DSH_TOKEN_FILE=/data/yongjie/dsh-token
DSH_PUBLIC_URL=
DSH_CARDS_STORE=~/.dsh/storages/yongjie-cards.json
