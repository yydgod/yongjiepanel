diff --git a/packages/client/ui-brand-official/src/client/CardsHome.tsx b/packages/client/ui-brand-official/src/client/CardsHome.tsx
new file mode 100644
index 00000000..c6a0173f
--- /dev/null
+++ b/packages/client/ui-brand-official/src/client/CardsHome.tsx
@@ -0,0 +1,176 @@
+/**
+ * 永杰面板首页：把已注册的 Workspace 渲染成卡片，点击直接进入 dsh 原生工作区。
+ *
+ * 该组件挂在 `conversation.hero.frame` HOC 槽上：仅在 home（hero=true）时接管
+ * 内容区域，选中工作区后交还给 dsh 原生界面。
+ */
+import { useEffect, useState, useSyncExternalStore, type ReactNode } from 'react'
+import { hasEnteredWorkspace, markEnteredWorkspace, subscribeEntered } from './cardsState.ts'
+
+type WorkspaceItem = {
+  workspaceId: string
+  title: string
+  path: string
+  sessionIds?: readonly string[]
+}
+
+type Snapshot = {
+  items: readonly WorkspaceItem[]
+  state: string
+}
+
+type Source = {
+  getSnapshot: () => Snapshot
+  subscribe: (listener: () => void) => () => void
+}
+
+const EMPTY: Snapshot = { items: [], state: 'idle' }
+
+let source: Source | null = null
+let openWorkspace: ((workspaceId: string) => Promise<void>) | null = null
+
+/** 由插件 apply() 注入 dsh 的工作区数据源与导航能力。 */
+export function configureCards(nextSource: Source | null, nextOpen: typeof openWorkspace): void {
+  source = nextSource
+  openWorkspace = nextOpen
+}
+
+function subscribe(listener: () => void): () => void {
+  return source?.subscribe(listener) ?? (() => {})
+}
+
+function getSnapshot(): Snapshot {
+  return source?.getSnapshot() ?? EMPTY
+}
+
+const palette = ['#35E0C8', '#7C6CFF', '#3B82F6', '#F5A524', '#FF5C7A', '#34D399']
+
+function colorFor(seed: string): string {
+  let hash = 0
+  for (const char of seed) hash = (hash * 31 + char.charCodeAt(0)) >>> 0
+  return palette[hash % palette.length]!
+}
+
+async function enter(workspaceId: string): Promise<void> {
+  markEnteredWorkspace()
+  if (!openWorkspace) return
+  await openWorkspace(workspaceId)
+}
+
+export function CardsHome({ hero, children }: { hero?: boolean; children?: ReactNode }): ReactNode {
+  const snapshot = useSyncExternalStore(subscribe, getSnapshot)
+  const [entered, setEntered] = useState(hasEnteredWorkspace)
+  useEffect(() => subscribeEntered(() => setEntered(hasEnteredWorkspace())), [])
+  if (!hero || entered) return children
+
+  const items = snapshot.items.filter((item) => item.path !== '/root')
+
+  return (
+    <div
+      style={{
+        display: 'flex',
+        flexDirection: 'column',
+        alignItems: 'center',
+        justifyContent: 'center',
+        gap: 20,
+        minHeight: '100%',
+        padding: '40px 28px 72px',
+        color: 'inherit',
+      }}
+    >
+      <div style={{ textAlign: 'center' }}>
+        <div style={{ fontSize: 22, fontWeight: 600, letterSpacing: '0.02em' }}>工作区</div>
+        <div style={{ marginTop: 6, fontSize: 13, opacity: 0.62 }}>
+          每张卡片对应一个独立工作区，点击进入 dsh 原生界面
+        </div>
+      </div>
+
+      {snapshot.state === 'loading' && items.length === 0 ? (
+        <div style={{ fontSize: 13, opacity: 0.6 }}>正在加载工作区…</div>
+      ) : items.length === 0 ? (
+        <div style={{ fontSize: 13, opacity: 0.6 }}>还没有工作区，请先在 dsh 中创建或运行迁移脚本</div>
+      ) : (
+        <div
+          style={{
+            display: 'grid',
+            width: '100%',
+            maxWidth: 920,
+            gap: 14,
+            gridTemplateColumns: 'repeat(auto-fill, minmax(190px, 1fr))',
+          }}
+        >
+          {items.map((item) => {
+            const accent = colorFor(item.workspaceId)
+            const initial = (item.title || 'W').trim().slice(0, 1).toUpperCase()
+            return (
+              <button
+                key={item.workspaceId}
+                type="button"
+                onClick={() => void enter(item.workspaceId)}
+                style={{
+                  display: 'flex',
+                  flexDirection: 'column',
+                  alignItems: 'flex-start',
+                  gap: 10,
+                  padding: '16px 16px 14px',
+                  borderRadius: 14,
+                  border: '1px solid rgba(127,127,127,0.22)',
+                  background: 'rgba(127,127,127,0.07)',
+                  color: 'inherit',
+                  textAlign: 'left',
+                  cursor: 'pointer',
+                  transition: 'background 0.18s ease, border-color 0.18s ease, transform 0.18s ease',
+                }}
+                onMouseEnter={(event) => {
+                  event.currentTarget.style.background = 'rgba(127,127,127,0.16)'
+                  event.currentTarget.style.borderColor = accent
+                  event.currentTarget.style.transform = 'translateY(-1px)'
+                }}
+                onMouseLeave={(event) => {
+                  event.currentTarget.style.background = 'rgba(127,127,127,0.07)'
+                  event.currentTarget.style.borderColor = 'rgba(127,127,127,0.22)'
+                  event.currentTarget.style.transform = 'translateY(0)'
+                }}
+              >
+                <span
+                  style={{
+                    display: 'inline-flex',
+                    alignItems: 'center',
+                    justifyContent: 'center',
+                    width: 34,
+                    height: 34,
+                    borderRadius: 10,
+                    background: `${accent}22`,
+                    color: accent,
+                    fontWeight: 700,
+                    fontSize: 16,
+                  }}
+                >
+                  {initial}
+                </span>
+                <span style={{ fontSize: 15, fontWeight: 600, lineHeight: 1.3 }}>{item.title}</span>
+                <span
+                  style={{
+                    maxWidth: '100%',
+                    overflow: 'hidden',
+                    textOverflow: 'ellipsis',
+                    whiteSpace: 'nowrap',
+                    fontSize: 11.5,
+                    opacity: 0.55,
+                    fontFamily: 'ui-monospace, monospace',
+                  }}
+                  title={item.path}
+                >
+                  {item.path}
+                </span>
+                <span style={{ fontSize: 11.5, opacity: 0.55 }}>
+                  {item.sessionIds?.length ?? 0} 个会话
+                </span>
+              </button>
+            )
+          })}
+        </div>
+      )}
+    </div>
+  )
+}
