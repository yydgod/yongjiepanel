@@ -0,0 +1,25 @@
+/** 卡片首页是否已被一次「进入工作区」接管；刷新后保持，避免卡片网格盖住会话。 */
+const KEY = 'yongjie.cards.entered'
+const EVENT = 'yongjie-cards-entered'
+
+export function hasEnteredWorkspace(): boolean {
+  try {
+    return sessionStorage.getItem(KEY) === '1'
+  } catch {
+    return false
+  }
+}
+
+export function markEnteredWorkspace(): void {
+  try {
+    sessionStorage.setItem(KEY, '1')
+  } catch {
+    // private mode：忽略持久化失败，仅通知当前页面
+  }
+  window.dispatchEvent(new Event(EVENT))
+}
+
+export function subscribeEntered(listener: () => void): () => void {
+  window.addEventListener(EVENT, listener)
+  return () => window.removeEventListener(EVENT, listener)
+}
diff --git a/packages/client/ui-brand-official/src/client/index.ts b/packages/client/ui-brand-official/src/client/index.ts
index e5dc78b0..fc13f594 100644
--- a/packages/client/ui-brand-official/src/client/index.ts
+++ b/packages/client/ui-brand-official/src/client/index.ts
@@ -5,15 +5,93 @@ import type {} from '@deepseek-ai/dsh-client-ui-sidebar/client'
 import type {} from '@deepseek-ai/dsh-client-ui-conversation/client'
 import { PixelWhale } from './home-whale/PixelWhale.tsx'
 import { OfficialBrandMark, OfficialBrandName } from './Brand.tsx'
+import { CardsHome, configureCards } from './CardsHome.tsx'
+import { CardsOverlay, configureOverlay } from './CardsOverlay.tsx'
+import { markEnteredWorkspace } from './cardsState.ts'
 
 /** Required service: the UI slot registry. */
-export const inject = ['slots']
+export const inject = ['slots', 'workspaces', 'uiWorkspace']
+
+/** 支持 /?workspace=<id> 深链：看板卡片可直接进入指定工作区的原生界面。 */
+function enterWorkspaceFromQuery(services: {
+  workspaces?: { list?: { getSnapshot?: () => { items?: readonly { workspaceId: string }[] } } }
+  uiWorkspace?: { startSession?: (workspaceId?: string) => void }
+}): void {
+  if (typeof window === 'undefined') return
+  const workspaceId = new URL(window.location.href).searchParams.get('workspace')
+  if (!workspaceId) return
+  markEnteredWorkspace()
+  const open = (): void => {
+    const items = services.workspaces?.list?.getSnapshot?.()?.items ?? []
+    if (items.some((item) => item.workspaceId === workspaceId)) {
+      services.uiWorkspace?.startSession?.(workspaceId)
+    }
+  }
+  // 会话恢复可能晚于首帧，多次覆盖，确保 URL 指定的工作区最终生效
+  for (const delay of [0, 400, 1200, 2400, 3600]) window.setTimeout(open, delay)
+}
+
+/** 加载中文字体并覆盖 dsh 默认字体栈，避免中文标题显示为方块。 */
+function installChineseFont(): void {
+  if (typeof document === 'undefined' || document.getElementById('yongjie-cjk-font')) return
+  const link = document.createElement('link')
+  link.rel = 'stylesheet'
+  link.href = 'https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600&display=swap'
+  document.head.appendChild(link)
+  const style = document.createElement('style')
+  style.id = 'yongjie-cjk-font'
+  style.textContent =
+    ':root{--dsw-font-family:"Noto Sans SC","PingFang SC","Microsoft YaHei",system-ui,sans-serif !important;}'
+    + 'body{font-family:var(--dsw-font-family) !important;}'
+  document.head.appendChild(style)
+
+  const stack = '"Noto Sans SC","PingFang SC","Microsoft YaHei",system-ui,sans-serif'
+  const applyFont = (): void => {
+    document.body.style.setProperty('font-family', stack, 'important')
+    document.documentElement.style.setProperty('--dsw-font-family', stack, 'important')
+  }
+  applyFont()
+  window.setTimeout(applyFont, 800)
+  window.setTimeout(applyFont, 2500)
+  void document.fonts?.load('14px "Noto Sans SC"').then(applyFont).catch(() => {})
+}
 
 /**
  * Fill official sidebar artwork and frame the blank home with the whale decoration.
  * @param ctx - Client root context.
  */
 export function apply(ctx: ClientContext): void {
+  const services = ctx as unknown as {
+    workspaces?: { list?: unknown }
+    uiWorkspace?: {
+      openWorkspace?: (workspaceId: string) => Promise<void>
+      startSession?: (workspaceId?: string) => void
+    }
+  }
+  const source = (services.workspaces?.list ?? null) as Parameters<typeof configureCards>[0]
+  const ui = services.uiWorkspace
+  const open = ui?.startSession
+    ? (workspaceId: string) => {
+        ui.startSession!(workspaceId)
+        return Promise.resolve()
+      }
+    : ui?.openWorkspace
+      ? (workspaceId: string) => ui.openWorkspace!(workspaceId)
+      : null
+  configureCards(source, open)
+  configureOverlay(source, open)
+  enterWorkspaceFromQuery(services as never)
+  installChineseFont()
+  ctx.slots.inject('shell.overlay', () =>
+    ctx.slots.register(
+      { name: 'shell.overlay', id: 'yongjie-cards-overlay' },
+      CardsOverlay as never,
+    ))
+  ctx.slots.inject('conversation.hero.frame', () =>
+    ctx.slots.register(
+      { name: 'conversation.hero.frame', id: 'yongjie-cards' },
+      CardsHome as never,
+    ))
   ctx.slots.inject('conversation.hero.frame', () => ctx.slots.register({
     name: 'conversation.hero.frame',
     id: 'pixel-whale',
