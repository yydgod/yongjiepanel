+/**
+ * 常驻「工作区」入口：右下角浮动按钮 + 卡片弹层。
+ * 点击卡片直接调用 ctx.uiWorkspace.openWorkspace()，进入 dsh 原生工作区。
+ */
+import { useState, useSyncExternalStore, type ReactNode } from 'react'
+import { markEnteredWorkspace } from './cardsState.ts'
+
+type WorkspaceItem = {
+  workspaceId: string
+  title: string
+  path: string
+  sessionIds?: readonly string[]
+}
+
+type Snapshot = { items: readonly WorkspaceItem[]; state: string }
+type Source = {
+  getSnapshot: () => Snapshot
+  subscribe: (listener: () => void) => () => void
+}
+
+let source: Source | null = null
+let openWorkspace: ((workspaceId: string) => Promise<void>) | null = null
+
+export function configureOverlay(nextSource: Source | null, nextOpen: typeof openWorkspace): void {
+  source = nextSource
+  openWorkspace = nextOpen
+}
+
+const EMPTY: Snapshot = { items: [], state: 'idle' }
+const subscribe = (listener: () => void): (() => void) => source?.subscribe(listener) ?? (() => {})
+const getSnapshot = (): Snapshot => source?.getSnapshot() ?? EMPTY
+
+const palette = ['#35E0C8', '#7C6CFF', '#3B82F6', '#F5A524', '#FF5C7A', '#34D399']
+
+function colorFor(seed: string): string {
+  let hash = 0
+  for (const char of seed) hash = (hash * 31 + char.charCodeAt(0)) >>> 0
+  return palette[hash % palette.length]!
+}
+
+export function CardsOverlay(): ReactNode {
+  const [open, setOpen] = useState(false)
+  const snapshot = useSyncExternalStore(subscribe, getSnapshot)
+  const items = snapshot.items.filter((item) => item.path !== '/root')
+
+  const enter = (workspaceId: string): void => {
+    setOpen(false)
+    markEnteredWorkspace()
+    void openWorkspace?.(workspaceId)
+  }
+
+  return (
+    <>
+      <button
+        type="button"
+        onClick={() => setOpen(true)}
+        title="工作区卡片"
+        style={{
+          position: 'fixed',
+          right: 22,
+          bottom: 22,
+          zIndex: 9000,
+          display: 'inline-flex',
+          alignItems: 'center',
+          gap: 8,
+          padding: '9px 14px',
+          borderRadius: 999,
+          border: '1px solid rgba(127,127,127,0.28)',
+          background: 'var(--dsw-alias-bg-elevated, rgba(127,127,127,0.12))',
+          color: 'inherit',
+          fontSize: 13,
+          cursor: 'pointer',
+          boxShadow: '0 8px 24px rgba(0,0,0,0.16)',
+        }}
+      >
+        <span
+          style={{
+            display: 'grid',
+            gridTemplateColumns: '1fr 1fr',
+            gap: 2,
+            width: 12,
+            height: 12,
+          }}
+          aria-hidden="true"
+        >
+          {[0, 1, 2, 3].map((index) => (
+            <span key={index} style={{ background: 'currentColor', borderRadius: 2, opacity: 0.75 }} />
+          ))}
+        </span>
+        工作区
+      </button>
+
+      {open && (
+        <div
+          role="dialog"
+          aria-modal="true"
+          onClick={() => setOpen(false)}
+          style={{
+            position: 'fixed',
+            inset: 0,
+            zIndex: 9100,
+            display: 'flex',
+            alignItems: 'center',
+            justifyContent: 'center',
+            padding: 24,
+            background: 'rgba(0,0,0,0.38)',
+            backdropFilter: 'blur(4px)',
+          }}
+        >
+          <div
+            onClick={(event) => event.stopPropagation()}
+            style={{
+              width: 'min(860px, 100%)',
+              maxHeight: 'min(78vh, 720px)',
+              overflow: 'auto',
+              padding: 24,
+              borderRadius: 18,
+              border: '1px solid rgba(127,127,127,0.24)',
+              background: 'var(--dsw-alias-bg-base, #fff)',
+              color: 'var(--dsw-alias-label-primary, #111)',
+              boxShadow: '0 32px 80px rgba(0,0,0,0.28)',
+            }}
+          >
+            <div style={{ display: 'flex', alignItems: 'center', marginBottom: 16 }}>
+              <div>
+                <div style={{ fontSize: 19, fontWeight: 600 }}>工作区</div>
+                <div style={{ marginTop: 4, fontSize: 12.5, opacity: 0.6 }}>
+                  选择卡片进入 dsh 原生工作区，模型与权限沿用 dsh 设置
+                </div>
+              </div>
+              <button
+                type="button"
+                onClick={() => setOpen(false)}
+                style={{
+                  marginLeft: 'auto',
+                  border: 'none',
+                  background: 'transparent',
+                  color: 'inherit',
+                  fontSize: 20,
+                  cursor: 'pointer',
+                  opacity: 0.5,
+                }}
+                aria-label="关闭"
+              >
+                ×
+              </button>
+            </div>
+
+            {items.length === 0 ? (
+              <div style={{ padding: '32px 0', textAlign: 'center', fontSize: 13, opacity: 0.6 }}>
+                还没有工作区，请先创建或运行迁移脚本
+              </div>
+            ) : (
+              <div
+                style={{
+                  display: 'grid',
+                  gap: 12,
+                  gridTemplateColumns: 'repeat(auto-fill, minmax(190px, 1fr))',
+                }}
+              >
+                {items.map((item) => {
+                  const accent = colorFor(item.workspaceId)
+                  return (
+                    <button
+                      key={item.workspaceId}
+                      type="button"
+                      onClick={() => enter(item.workspaceId)}
+                      style={{
+                        display: 'flex',
+                        flexDirection: 'column',
+                        alignItems: 'flex-start',
+                        gap: 9,
+                        padding: '14px 14px 12px',
+                        borderRadius: 12,
+                        border: '1px solid rgba(127,127,127,0.2)',
+                        background: 'rgba(127,127,127,0.06)',
+                        color: 'inherit',
+                        textAlign: 'left',
+                        cursor: 'pointer',
+                      }}
+                    >
+                      <span
+                        style={{
+                          display: 'inline-flex',
+                          alignItems: 'center',
+                          justifyContent: 'center',
+                          width: 30,
+                          height: 30,
+                          borderRadius: 9,
+                          background: `${accent}22`,
+                          color: accent,
+                          fontWeight: 700,
+                        }}
+                      >
+                        {(item.title || 'W').trim().slice(0, 1).toUpperCase()}
+                      </span>
+                      <span style={{ fontSize: 14.5, fontWeight: 600 }}>{item.title}</span>
+                      <span
+                        style={{
+                          maxWidth: '100%',
+                          overflow: 'hidden',
+                          textOverflow: 'ellipsis',
+                          whiteSpace: 'nowrap',
+                          fontSize: 11,
+                          opacity: 0.55,
+                          fontFamily: 'ui-monospace, monospace',
+                        }}
+                        title={item.path}
+                      >
+                        {item.path}
+                      </span>
+                    </button>
+                  )
+                })}
+              </div>
+            )}
+          </div>
+        </div>
+      )}
+    </>
+  )
+}
